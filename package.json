{
  "name": "pink",
  "version": "2.4.1",
  "description": "Catálogo de quadrinhos",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "vite",
    "server": "bun run --watch src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev src/worker/index.ts",
    "worker:deploy": "wrangler deploy",
    "cf:pages:deploy": "wrangler pages deploy dist --project-name pink",
    "cf:pages:deploy:prod": "wrangler pages deploy dist --project-name pink --branch main"
  },
  "keywords": [
    "comics",
    "catalog",
    "bun",
    "elysia",
    "react",
    "typescript"
  ],
  "author": "Zweihander",
  "license": "ISC",
  "devDependencies": {
    "vite": "^7.1.2",
    "wrangler": "^4.33.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "hono": "^4.9.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.13.0"
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
